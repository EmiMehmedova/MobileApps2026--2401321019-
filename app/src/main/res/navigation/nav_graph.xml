<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/bookListFragment">

    <fragment
        android:id="@+id/bookListFragment"
        android:name="com.emi.bookshelf.ui.BookListFragment"
        android:label="@string/title_list"
        tools:layout="@layout/fragment_book_list">
        <action
            android:id="@+id/action_list_to_edit"
            app:destination="@id/bookEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookEditFragment"
        android:name="com.emi.bookshelf.ui.BookEditFragment"
        android:label="@string/title_edit"
        tools:layout="@layout/fragment_book_edit">
        <argument
            android:name="bookId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>
</navigation>